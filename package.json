{
  "name": "kavibay",
  "private": true,
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:linux": "bash scripts/dev-linux.sh",
    "package:win": "tauri build --bundles nsis",
    "package:win:standalone": "tauri build --no-bundle",
    "package:linux": "tauri build --bundles appimage,deb",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test:assert": "node scripts/runAsserts.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --target-dir src-tauri/target/check --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --target-dir src-tauri/target/check --lib",
    "build:guest": "vite build --config vite.guest.config.ts && node scripts/guestHeader.mjs",
    "build:embed": "vite build --config vite.embed.config.ts",
    "dev:landing": "vite --config landing/vite.config.js --port 5180 --strictPort",
    "build:provider-doc": "tsx scripts/writeProviderSchemaDoc.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hiseb/confetti": "^2.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/extension-underline": "^3.28.0",
    "@tiptap/markdown": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@tiptap/vue-3": "^3.28.0",
    "semver": "^7.8.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "tsx": "^4.23.11",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
