{
  "name": "kavibay",
  "private": true,
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:linux": "bash scripts/dev-linux.sh",
    "package:win": "tauri build --bundles nsis",
    "package:win:standalone": "tauri build --no-bundle",
    "package:linux": "tauri build --bundles appimage,deb",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:fast": "vue-tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/vue-tsc.tsbuildinfo",
    "lint": "oxlint .",
    "test:assert": "node scripts/runAsserts.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --target-dir src-tauri/target/check --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --target-dir src-tauri/target/check --lib",
    "build:guest": "vite build --config vite.guest.config.ts && node scripts/guestHeader.mjs",
    "build:embed": "vite build --config vite.embed.config.ts",
    "build:provider-doc": "tsx scripts/writeProviderSchemaDoc.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hiseb/confetti": "^2.2.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "semver": "^7.8.5",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "oxlint": "^1.85.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
