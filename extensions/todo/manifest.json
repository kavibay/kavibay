{
  "format": "contract",
  "name": "todo",
  "version": "1.0.0",
  "displayName": "Todo",
  "description": "Nestable checklist with drag reorder and inline editing.",
  "author": "kavibay",
  "engines": { "kavibay": "^0.1" },
  "keywords": ["todo", "tasks", "checklist", "aufgaben", "liste"],
