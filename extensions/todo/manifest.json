    "todo": {
      "replaces": "todo",
      "keywords": ["todo", "tasks", "checklist", "aufgaben", "liste"],
      "categories": ["productivity"],
      "ui": {
        "defaultOffset": { "x": 240, "y": 420 },
        "defaultSize": { "w": 280, "h": 260 },
        "grabCursor": false
      },
      "actions": [
        {
          "id": "todo-add",
          "title": "Add Todo",
          "subtitle": "Append a task",
          "keywords": ["todo", "task", "add", "new"],
          "params": [
            { "name": "item", "type": "text", "required": true, "placeholder": "Task" }
          ]
        }
      ]
    }
  }
